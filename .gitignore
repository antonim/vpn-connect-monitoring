# Результаты сборки. Значок и exe генерируются build.ps1 из исходников,
# держать их в репозитории незачем — готовый exe удобнее раздавать
# через GitHub Releases.
build/

# Снимки окон от tools\render-settings.ps1
*.png

__pycache__/
*.pyc

# Настройки IDE от JetBrains: к проекту отношения не имеют, у каждого
# разработчика свои.
.idea/

# Служебные файлы Finder: появляются в любом каталоге, который открыли
# в проводнике, к проекту отношения не имеют.
.DS_Store
